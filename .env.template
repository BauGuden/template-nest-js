# Aplicación: http | microservice | hybrid
NODE_ENV=development
APP_NAME=template-service
APP_MODE=http
PORT=3000
API_PREFIX=api/v1

# Use * en desarrollo o una lista separada por comas.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
SWAGGER_ENABLED=true

# NATS (necesario en modo microservice o hybrid)
NATS_SERVERS=nats://localhost:4222
NATS_QUEUE=template-service
NATS_REQUEST_TIMEOUT=5000

# PostgreSQL / TypeORM (opcional)
DATABASE_ENABLED=false
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=template_db
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_SCHEMA=public
# No habilitar synchronize en producción; use migraciones.
DB_SYNCHRONIZE=false
DB_LOGGING=false
